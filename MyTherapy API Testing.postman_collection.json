          "name": "Get My Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function() {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response is an array\", function() {\r",
                  "    pm.expect(pm.response.json()).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"All slots belong to the therapist\", function() {\r",
                  "    response.forEach(slot => {\r",
                  "        pm.expect(slot.therapistId).to.equal(\r",
                  "            \"89f1cd95-952b-45b2-b1fd-29156bf68040\"\r",
                  "        );\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each slot contains required fields\", function() {\r",
                  "    response.forEach(slot => {\r",
                  "        pm.expect(slot).to.have.property(\"slotId\");\r",
                  "        pm.expect(slot).to.have.property(\"therapistId\");\r",
                  "        pm.expect(slot).to.have.property(\"startTime\");\r",
                  "        pm.expect(slot).to.have.property(\"endTime\");\r",
                  "        pm.expect(slot).to.have.property(\"isBooked\");\r",
                  "    })\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Start time is before end time\", function() {\r",
                  "    response.forEach(slot => {\r",
                  "        pm.expect(\r",
                  "            new Date(slot.startTime)\r",
                  "        ).to.be.below(new Date(slot.endTime));\r",
                  "    });\r",
                  "});"
