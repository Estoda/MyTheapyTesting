        {
          "name": "Book Appointment - Valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking request succeeded\", function() {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Response contains appointmentId\", function () {\r",
                  "    pm.expect(response.appointmentId).to.exist;\r",
                  "    pm.expect(response.appointmentId).to.not.be.empty;\r",
                  "    pm.expect(response.appointmentId).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains slotId\", function () {\r",
                  "    pm.expect(response.slotId).to.exist;\r",
                  "    pm.expect(response.slotId).to.not.be.empty;\r",
                  "    pm.expect(response.slotId).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains therapist name\", function() {\r",
                  "    pm.expect(response.therapistName).to.exist;\r",
                  "    pm.expect(response.therapistName).to.not.be.empty;\r",
                  "    pm.expect(response.therapistName).to.be.a('string');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Appointment status is Scheduled\", function() {\r",
                  "    pm.expect(response.status).to.equal('Scheduled');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Duration is 60 minutes\", function() {\r",
                  "    pm.expect(response.durationMinutes).to.equal(60);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Appointment datetime exists\", function() {\r",
                  "    pm.expect(response.appointmentDatetime).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"CreatedAt exists\", function() {\r",
                  "    pm.expect(response.createdAt).to.exist;\r",
                  "});\r",
                  "\r",
                  "// for future requests\r",
                  "pm.environment.set(\"appointmentId\", response.appointmentId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
