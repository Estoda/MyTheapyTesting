        {
          "name": "Get My Appointments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response is an array\", function() {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Appointment list is not empty\", function() {\r",
                  "    const appointments = pm.response.json();\r",
                  "\r",
                  "    pm.expect(appointments.length).to.be.greaterThan(0);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Booked appointment exists in patient's appointments\", function() {\r",
                  "    const appointments = pm.response.json();\r",
                  "\r",
                  "    const appointment = appointments.find(\r",
                  "        item => item.appointmentId === pm.environment.get(\"appointmentId\")\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(appointment).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Appointment status is Scheduled\", function() {\r",
                  "    const appointments = pm.response.json();\r",
                  "\r",
                  "    const appointment = appointments.find(\r",
                  "        item => item.appointmentId === pm.environment.get(\"appointmentId\")\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(appointment).to.exist;\r",
                  "    pm.expect(appointment.status).to.eql(\"Scheduled\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
